              }
            }
          },
          "401": {
            "description": "Não autorizado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "clerk": []
          }
        ]
      }
    },
    "/sync/push": {
      "post": {
        "tags": [
          "sync"
        ],
        "summary": "Grava um lote de sync.",
        "operationId": "push",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SyncPushRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Lote aplicado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncApplied"
                }
              }
            }
          },
          "400": {
            "description": "JSON ou linha inválida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Não autorizado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "Mais de 500 linhas ou 1 MiB",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "clerk": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ActivityResponse": {
        "type": "object",
        "description": "Página de `GET /admin/api/owners/{owner_id}/activity`.",
        "required": [
          "records",
          "limit",
          "offset",
          "total"
        ],
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 0
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "records": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AdminActivity"
            }
          },
          "total": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "AdminActivity": {
        "type": "object",
        "description": "Linha recente de qualquer tabela de sync.",
        "required": [
          "table",
          "uuid",
          "updated_at",
          "seq"
        ],
        "properties": {
          "deleted_at": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "seq": {
            "type": "integer",
            "format": "int64"
          },
          "summary": {
            "type": [
              "string",
              "null"
            ]
          },
          "table": {
            "type": "string"
          },
          "updated_at": {
            "type": "integer",
            "format": "int64"
          },
          "uuid": {
            "type": "string"
          }
        }
      },
      "AdminCollection": {
        "type": "object",
        "description": "Coleção sincronizada e quantos itens vivos ela tem.",
        "required": [
          "uuid",
          "items",
          "updated_at",
          "seq"
        ],
        "properties": {
          "deleted_at": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "items": {
            "type": "integer",
            "format": "int64"
          },
          "kind": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "seq": {
            "type": "integer",
            "format": "int64"
          },
          "share_slug": {
            "type": [
              "string",
              "null"
            ]
          },
          "store": {
            "type": [
              "string",
              "null"
            ]
          },
          "updated_at": {
            "type": "integer",
            "format": "int64"
          },
          "uuid": {
            "type": "string"
          }
        }
      },
      "AdminOverview": {
        "type": "object",
        "description": "Totais do D1, sem o subject reservado `__guest__`.\n\n`products`, `collections` e `collection_items` contam linhas vivas\n(`deleted_at` nulo). `shares` conta a ponte `sync_collection_shares`.\n`last_sync_at` é o maior `updated_at` (Unix ms do cliente), tombstone incluído.",
        "required": [
          "owners",
          "products",
          "collections",
          "collection_items",
          "shares"
        ],
        "properties": {
          "collection_items": {
            "type": "integer",
            "format": "int64"
          },
          "collections": {
            "type": "integer",
            "format": "int64"
          },
          "last_sync_at": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "owners": {
            "type": "integer",
            "format": "int64"
          },
          "products": {
            "type": "integer",
            "format": "int64"
          },
          "shares": {
            "type": "integer",
            "format": "int64"
          }
