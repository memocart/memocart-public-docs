    "/s/{slug}": {
      "get": {
        "tags": [
          "share"
        ],
        "summary": "Carrinho público de um slug.",
        "operationId": "open",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "description": "Slug do link público.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Carrinho e itens",
