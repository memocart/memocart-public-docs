                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/sync/collections/{uuid}/share": {
      "post": {
        "tags": [
          "share"
        ],
        "summary": "Cria ou reaproveita o link público de uma coleção.",
        "operationId": "create",
        "parameters": [
          {
            "name": "uuid",
            "in": "path",
            "description": "UUID da coleção sincronizada.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Link reaproveitado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncShareResponse"
                }
              }
            }
          },
          "201": {
            "description": "Link novo",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncShareResponse"
                }
              }
            }
          },
          "400": {
            "description": "Coleção sem itens com link http(s)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Não autorizado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Coleção não encontrada para o dono",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "clerk": []
          }
        ]
      },
      "delete": {
        "tags": [
          "share"
        ],
        "summary": "Revoga o link público de uma coleção.",
        "operationId": "revoke",
        "parameters": [
          {
            "name": "uuid",
            "in": "path",
            "description": "UUID da coleção sincronizada.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Revogado, ou não havia link."
          },
          "401": {
            "description": "Não autorizado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Coleção não é do dono",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "clerk": []
          }
        ]
      }
    },
    "/sync/pull": {
      "get": {
        "tags": [
          "sync"
        ],
        "summary": "Página de mudanças depois do cursor.",
        "operationId": "pull",
        "parameters": [
          {
            "name": "since",
            "in": "query",
            "description": "Cursor exclusivo. Padrão 0.",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "1..=500. Padrão 200. Acima de 500 vira 500.",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Página de sync",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncPage"
                }
              }
            }
          },
          "400": {
            "description": "`since` ou `limit` inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
