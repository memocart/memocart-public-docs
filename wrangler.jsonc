{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "memocart-docs",
	// Compatibilidade do dia em que o Worker foi criado.
	"compatibility_date": "2026-10-23",
	"compatibility_flags": ["nodejs_compat"],
	// O site público é o custom domain. workers.dev fica desligado.
	"workers_dev": false,
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 0.01
		}
	},
	// Site estático do Astro. Sem script de Worker: o binding ASSETS não se aplica.
	"assets": {
		"directory": "./dist",
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "404-page"
	},
	// Zona memocart.link. O Worker é a origem de docs.memocart.link.
	"routes": [
		{
			"pattern": "docs.memocart.link",
			"zone_name": "memocart.link",
			"custom_domain": true
		}
	]
}
